{# Configuration fragment — no {% extends %} — rendered inside the module-configure page #}

{# Configuration card #}
<div class="card mb-4">
    <div class="card-header">
        {{ 'Configuration.'|trans({}, 'customdelivery.bo.default') }}
    </div>
    <div class="card-body">

        {{ form_start(form, {attr: {id: 'customdelivery-form', method: 'POST', action: path('customdelivery.admin.configuration')}}) }}

        {% if form.vars.errors|length %}
            <div class="alert alert-danger">
                {% for error in form.vars.errors %}{{ error.message }}{% endfor %}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.url, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.url, {attr: {class: 'form-control' ~ (form.url.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.url.vars.help is defined and form.url.vars.help %}
                <div class="form-text">{{ form.url.vars.help }}</div>
            {% endif %}
            {{ form_errors(form.url) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.method, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.method, {attr: {class: 'form-select' ~ (form.method.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.method.vars.help is defined and form.method.vars.help %}
                <div class="form-text">{{ form.method.vars.help }}</div>
            {% endif %}
            {{ form_errors(form.method) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.tax, null, {label_attr: {class: 'form-label'}}) }}
            <select id="{{ form.tax.vars.id }}" name="{{ form.tax.vars.full_name }}"
                    class="form-select{{ form.tax.vars.errors|length ? ' is-invalid' : '' }}">
                <option value="" {% if form.tax.vars.value == 0 %}selected{% endif %}>
                    {{ 'No taxes'|trans({}, 'customdelivery.bo.default') }}
                </option>
                {% for taxRule in taxRules %}
                    <option value="{{ taxRule.id }}" {% if form.tax.vars.value == taxRule.id %}selected{% endif %}>
                        {{ taxRule.id }}: {{ taxRule.title }}
                    </option>
                {% endfor %}
            </select>
            {% do form.tax.setRendered %}
            {{ form_errors(form.tax) }}
        </div>

        <button type="submit" id="vpg-save" name="customdelivery_save" value="save"
                class="btn btn-primary btn-sm"
                title="{{ 'Save'|trans({}, 'customdelivery.bo.default') }}">
            {{ 'Save'|trans({}, 'customdelivery.bo.default') }}
        </button>

        {{ form_end(form) }}
    </div>
</div>

{# Slices card #}
<div class="card mb-4">
    <div class="card-header">
        {{ 'Slices.'|trans({}, 'customdelivery.bo.default') }}
    </div>
    <div id="slices" class="card-body">

        {% if areas|length %}
            {% for area in areas %}
                <div class="mb-4">
                    <div class="table-responsive">
                        <table class="table table-striped table-sm" data-area-id="{{ area.id }}">
                            <caption>
                                <small>{{ 'Area : '|trans({}, 'customdelivery.bo.default') }}</small> {{ area.name }}
                            </caption>
                            <thead>
                                <tr>
                                    {% if method != 2 %}
                                        <th class="col-3">{{ 'Untaxed Price up to ... %symbol'|trans({'%symbol': currencySymbol}, 'customdelivery.bo.default') }}</th>
                                    {% endif %}
                                    {% if method != 1 %}
                                        <th class="col-3">{{ 'Weight up to ... kg'|trans({}, 'customdelivery.bo.default') }}</th>
                                    {% endif %}
                                    <th class="col-5">{{ 'Price (%symbol)'|trans({'%symbol': currencySymbol}, 'customdelivery.bo.default') }}</th>
                                    <th class="col-1">{{ 'Actions'|trans({}, 'customdelivery.bo.default') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for slice in area.slices %}
                                    <tr class="js-slice" data-area="{{ area.id }}" data-id="{{ slice.id }}">
                                        {% if method != 2 %}
                                            <td>
                                                <input type="text" data-field="price-max"
                                                       class="form-control js-slice-price-max"
                                                       value="{{ slice.priceMax }}" data-old="{{ slice.priceMax }}" />
                                            </td>
                                        {% endif %}
                                        {% if method != 1 %}
                                            <td>
                                                <input type="text" data-field="weight-max"
                                                       class="form-control js-slice-weight-max"
                                                       value="{{ slice.weightMax }}" data-old="{{ slice.weightMax }}" />
                                            </td>
                                        {% endif %}
                                        <td>
                                            <input type="text" data-field="price"
                                                   class="form-control js-slice-price"
                                                   value="{{ slice.price }}" data-old="{{ slice.price }}" />
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                {% if is_granted('UPDATE', {resource: 'admin.module', module: 'CustomDelivery'}) %}
                                                    <a class="btn btn-secondary btn-sm js-slice-save"
                                                       title="{{ 'Save this price slice'|trans({}, 'customdelivery.bo.default') }}">
                                                        <i class="bi bi-save"></i>
                                                    </a>
                                                {% endif %}
                                                {% if is_granted('DELETE', {resource: 'admin.module', module: 'CustomDelivery'}) %}
                                                    <a class="btn btn-danger btn-sm js-slice-delete"
                                                       title="{{ 'Delete this price slice'|trans({}, 'customdelivery.bo.default') }}"
                                                       data-id="{{ slice.id }}">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}

                                {# New slice row #}
                                {% if is_granted('CREATE', {resource: 'admin.module', module: 'CustomDelivery'}) %}
                                    <tr class="js-slice-new" data-area="{{ area.id }}" data-id="0">
                                        {% if method != 2 %}
                                            <td>
                                                <input type="text" data-field="price-max"
                                                       class="form-control js-slice-price-max" value="" />
                                            </td>
                                        {% endif %}
                                        {% if method != 1 %}
                                            <td>
                                                <input type="text" data-field="weight-max"
                                                       class="form-control js-slice-weight-max" value="" />
                                            </td>
                                        {% endif %}
                                        <td>
                                            <input type="text" data-field="price"
                                                   class="form-control js-slice-price" value="" />
                                        </td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm js-slice-add"
                                               title="{{ 'Add this price slice'|trans({}, 'customdelivery.bo.default') }}">
                                                <i class="bi bi-plus-lg"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="alert alert-warning">
                {{ 'You should first attribute shipping zones to the modules: '|trans({}, 'customdelivery.bo.default') }}
                <a href="/admin/configuration/shipping_zones/update/{{ module_id }}">
                    {{ 'manage shipping zones'|trans({}, 'customdelivery.bo.default') }}
                </a>
            </div>
        {% endif %}

    </div>
</div>

{# Modal for messages #}
<div class="modal fade" id="custom_delivery_dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Message'|trans({}, 'customdelivery.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ 'Close'|trans({}, 'messages') }}
                </button>
            </div>
        </div>
    </div>
</div>

{# Slice row template #}
<template id="tpl-slice">
    <tr class="js-slice" data-area="" data-id="">
        {% if method != 2 %}
            <td>
                <input type="text" data-field="price-max" class="form-control js-slice-price-max" value="" data-old="" />
            </td>
        {% endif %}
        {% if method != 1 %}
            <td>
                <input type="text" data-field="weight-max" class="form-control js-slice-weight-max" value="" data-old="" />
            </td>
        {% endif %}
        <td>
            <input type="text" data-field="price" class="form-control js-slice-price" value="" data-old="" />
        </td>
        <td>
            <div class="btn-group">
                {% if is_granted('UPDATE', {resource: 'admin.module', module: 'CustomDelivery'}) %}
                    <a class="btn btn-secondary btn-sm js-slice-save"
                       title="{{ 'Save this price slice'|trans({}, 'customdelivery.bo.default') }}">
                        <i class="bi bi-save"></i>
                    </a>
                {% endif %}
                {% if is_granted('DELETE', {resource: 'admin.module', module: 'CustomDelivery'}) %}
                    <a class="btn btn-danger btn-sm js-slice-delete"
                       title="{{ 'Delete this price slice'|trans({}, 'customdelivery.bo.default') }}"
                       data-id="">
                        <i class="bi bi-trash"></i>
                    </a>
                {% endif %}
            </div>
        </td>
    </tr>
</template>
